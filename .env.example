# ============================================================
# 环境变量样例：复制为 .env 后填入自己的值
#   cp .env.example .env
# .env 已在 .gitignore 中，不会被提交
# ============================================================

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=health_check_system
DB_USERNAME=root
DB_PASSWORD=root

# --- AnythingLLM（本地 RAG 知识库）---
# 启动 AnythingLLM 后，在「设置 → 工具 → API Key」中生成
RAG_ENABLED=true
RAG_URL=http://localhost:3001
RAG_API_KEY=
RAG_WORKSPACE=health-check

# --- 敏感字段 AES-256-CBC 加密 ---
# 必须为 16 字节密钥的 Base64（即 24 个字符，以 == 结尾）
# 生成：openssl rand -base64 16
#
# ⚠️ 下面两个值是公开的占位默认值（base64 解码后是 "1234567890123456"），
#    且 key 与 iv 相同——这不符合 CBC 模式的安全要求。
#    它们只用于让仓库 clone 下来能直接跑通。部署前必须替换。
#    注意：改动密钥后，数据库中已加密的字段将无法解密，需要重新录入。
CRYPTO_AES_KEY=MTIzNDU2Nzg5MDEyMzQ1Ng==
CRYPTO_AES_IV=MTIzNDU2Nzg5MDEyMzQ1Ng==
